# Copia este archivo como .env y completa los valores reales.
# .env NUNCA debe subirse a git (ya está en .gitignore).

# Django
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-secreta-larga-y-aleatoria
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=

# Base de datos MySQL
DB_NAME=kuma_coffee
DB_USER=root
DB_PASSWORD=admin
DB_HOST=localhost
DB_PORT=3306

# Google OAuth 2.0 (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/cuentas/google/callback

# Zona horaria (opcional, se autodetecta si se omite)
DJANGO_TIME_ZONE=America/Bogota
